# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Кому можно пользоваться ботом — Telegram ID через запятую.
# Свой ID бот сам пришлёт в ответ на первое сообщение.
# Первому ID в списке приходят сообщения самопроверки.
ALLOWED_USERS=

# Браузер на базе Chromium: Chrome, Edge, Яндекс.Браузер. Пусто — Chrome, если установлен, иначе Edge.
# У каждого браузера свой профиль в папке программы: chrome-profile, у Edge — browser-profile.
BROWSER_PATH=
DEBUG_PORT=9222

# Сколько порций выдачи смотреть (порция — около 8 товаров) и сколько самых дешёвых показывать
PORTIONS=10
TOP=10

# Самопроверка разбора выдачи: раз в сколько часов искать контрольный запрос (0 — выключить)
SELF_CHECK_HOURS=6
SELF_CHECK_QUERY=наушники
